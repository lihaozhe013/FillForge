{
  "name": "fillforge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "type": "module",
  "description": "Local-first desktop app for configuring, filling, reviewing, and rendering DOCX templates",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @fillforge/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "biome lint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:win": "pnpm build && pnpm --filter @fillforge/desktop package:win",
    "build:win:x64": "pnpm build && pnpm --filter @fillforge/desktop package:win:x64",
    "build:mac": "pnpm build && pnpm --filter @fillforge/desktop package:mac",
    "build:mac:arm64": "pnpm build && pnpm --filter @fillforge/desktop package:mac:arm64",
    "build:mac:x64": "pnpm build && pnpm --filter @fillforge/desktop package:mac:x64",
    "fixtures": "tsx tests/fixtures/make-fixtures.ts && tsx examples/make-example.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@fillforge/tools": "workspace:*",
    "@types/node": "^22.20.3",
    "pizzip": "^3.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
