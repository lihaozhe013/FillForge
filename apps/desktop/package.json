{
  "name": "@docufill/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Docufill desktop application (Electron)",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
